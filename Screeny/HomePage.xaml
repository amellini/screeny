<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="Screeny.HomePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Screeny">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Intestazione -->
		<Grid Padding="40,24,40,20" ColumnSpacing="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Spacing="2">
				<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{local:L Key=Home_Title}" />
				<TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>
			<StackPanel
				Grid.Column="1"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="8">
				<Button ToolTipService.ToolTip="{local:L Key=Settings_Title}">
					<FontIcon FontSize="16" Glyph="&#xE713;" />
					<Button.Flyout>
						<Flyout Closed="SettingsFlyout_Closed" Placement="BottomEdgeAlignedRight">
							<StackPanel Width="320" Spacing="12">
								<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:L Key=Settings_Title}" />
								<RadioButtons x:Name="ThemeChoice" Header="{local:L Key=Settings_Theme}" SelectionChanged="ThemeChoice_SelectionChanged">
									<RadioButton Content="{local:L Key=Settings_ThemeSystem}" />
									<RadioButton Content="{local:L Key=Settings_ThemeLight}" />
									<RadioButton Content="{local:L Key=Settings_ThemeDark}" />
								</RadioButtons>
								<ComboBox
										x:Name="LanguageChoice"
										HorizontalAlignment="Stretch"
										Header="{local:L Key=Settings_Language}"
										SelectionChanged="LanguageChoice_SelectionChanged" />
									<TextBox x:Name="ScrcpyPathBox" Header="{local:L Key=Settings_ScrcpyPath}">
									<TextBox.Description>
										<TextBlock Text="{local:L Key=Settings_ScrcpyPathHelp}" TextWrapping="Wrap" />
									</TextBox.Description>
								</TextBox>
								<HyperlinkButton Padding="0" Click="OpenFolder_Click" Content="{local:L Key=Settings_OpenFolder}" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>
				<Button Click="New_Click" Style="{StaticResource AccentButtonStyle}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon FontSize="14" Glyph="&#xE710;" />
						<TextBlock Text="{local:L Key=Home_NewProfile}" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<InfoBar
			x:Name="ErrorBar"
			Grid.Row="1"
			Margin="40,0,40,16"
			Severity="Error">
			<InfoBar.ActionButton>
				<Button Click="ShowLog_Click" Content="{local:L Key=Home_ShowLog}" />
			</InfoBar.ActionButton>
		</InfoBar>

		<!-- Tile dei profili -->
		<ScrollViewer Grid.Row="2">
			<ItemsRepeater x:Name="Tiles" Margin="40,0,40,24">
				<ItemsRepeater.Layout>
					<UniformGridLayout
						ItemsStretch="Fill"
						MinColumnSpacing="12"
						MinItemHeight="184"
						MinItemWidth="280"
						MinRowSpacing="12" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate x:DataType="local:Profile">
						<local:ProfileTile DeleteRequested="Tile_DeleteRequested" EditRequested="Tile_EditRequested" Profile="{x:Bind}" />
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</ScrollViewer>

		<StackPanel
			x:Name="EmptyState"
			Grid.Row="2"
			MaxWidth="360"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="8">
			<FontIcon
				Margin="0,0,0,8"
				FontSize="40"
				Foreground="{ThemeResource TextFillColorTertiaryBrush}"
				Glyph="&#xE8EA;" />
			<TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{local:L Key=Home_EmptyTitle}" />
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{local:L Key=Home_EmptyText}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<Button
				Margin="0,8,0,0"
				HorizontalAlignment="Center"
				Click="New_Click"
				Content="{local:L Key=Home_EmptyButton}"
				Style="{StaticResource AccentButtonStyle}" />
		</StackPanel>

		<!-- Log dei processi scrcpy -->
		<Expander
			x:Name="LogExpander"
			Grid.Row="3"
			Margin="40,0,40,24"
			HorizontalAlignment="Stretch"
			HorizontalContentAlignment="Stretch"
			Header="{local:L Key=Home_Activity}">
			<ScrollViewer x:Name="LogScroll" MaxHeight="220">
				<TextBlock
					x:Name="LogText"
					FontFamily="Consolas"
					FontSize="12"
					IsTextSelectionEnabled="True"
					TextWrapping="Wrap" />
			</ScrollViewer>
		</Expander>
	</Grid>
</Page>
