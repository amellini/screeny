<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="Screeny.ProfileTile"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Screeny"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

	<Grid
		x:Name="Root"
		Height="184"
		Padding="20,18,16,14"
		Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		CornerRadius="8"
		RowSpacing="8"
		DoubleTapped="Root_DoubleTapped"
		GotFocus="Root_FocusChanged"
		LostFocus="Root_FocusChanged"
		PointerCanceled="Root_PointerExited"
		PointerEntered="Root_PointerEntered"
		PointerExited="Root_PointerExited">
		<Grid.BackgroundTransition>
			<BrushTransition Duration="0:0:0.12" />
		</Grid.BackgroundTransition>
		<!-- Riga etichette alta una sola linea: quelle che andrebbero a capo restano fuori (clip di layout). -->
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="22" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ContextFlyout>
			<MenuFlyout>
				<MenuFlyoutItem x:Name="PlayMenuItem" Click="Play_Click" Text="{local:L Key=Tile_Play}">
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE768;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
				<MenuFlyoutItem Click="Edit_Click" Text="{local:L Key=Tile_Edit}">
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE70F;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
				<MenuFlyoutSeparator />
				<MenuFlyoutItem Click="Delete_Click" Text="{local:L Key=Common_Delete}">
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE74D;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
			</MenuFlyout>
		</Grid.ContextFlyout>

		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="CommonStates">
				<VisualState x:Name="Normal" />
				<VisualState x:Name="PointerOver">
					<VisualState.Setters>
						<Setter Target="Root.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
						<Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
						<Setter Target="Actions.Opacity" Value="1" />
						<Setter Target="Footer.Opacity" Value="0" />
					</VisualState.Setters>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<!-- Icona + stato -->
		<Grid>
			<Border
				Width="36"
				Height="36"
				HorizontalAlignment="Left"
				Background="{ThemeResource SubtleFillColorSecondaryBrush}"
				CornerRadius="6">
				<FontIcon FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8EA;" />
			</Border>
			<Border
				x:Name="RunningBadge"
				Padding="8,3"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
				CornerRadius="10"
				Visibility="Collapsed">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
					<TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{local:L Key=Tile_Running}" />
				</StackPanel>
			</Border>
		</Grid>

		<TextBlock
			x:Name="NameText"
			Grid.Row="1"
			MaxLines="1"
			Style="{StaticResource SubtitleTextBlockStyle}"
			TextTrimming="CharacterEllipsis" />

		<toolkit:WrapPanel x:Name="Chips" Grid.Row="2" HorizontalSpacing="6" VerticalSpacing="6" />

		<Grid Grid.Row="4" MinHeight="32">
			<TextBlock
				x:Name="Footer"
				VerticalAlignment="Center"
				Foreground="{ThemeResource TextFillColorTertiaryBrush}"
				Style="{StaticResource CaptionTextBlockStyle}">
				<TextBlock.OpacityTransition>
					<ScalarTransition Duration="0:0:0.12" />
				</TextBlock.OpacityTransition>
			</TextBlock>
			<StackPanel
				x:Name="Actions"
				HorizontalAlignment="Right"
				Opacity="0"
				Orientation="Horizontal"
				Spacing="6">
				<StackPanel.OpacityTransition>
					<ScalarTransition Duration="0:0:0.12" />
				</StackPanel.OpacityTransition>
				<Button Click="Edit_Click" ToolTipService.ToolTip="{local:L Key=Tile_Edit}">
					<FontIcon FontSize="14" Glyph="&#xE70F;" />
				</Button>
				<Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource AccentButtonStyle}">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon x:Name="PlayIcon" FontSize="14" Glyph="&#xE768;" />
						<TextBlock x:Name="PlayText" Text="{local:L Key=Tile_Play}" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
